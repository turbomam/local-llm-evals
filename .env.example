# Copy to .env and fill in. .env is gitignored. Leave a key blank to skip that provider.

# Langfuse (tracing, scores, datasets). Project keys from the Langfuse project's settings page.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=sandbox

# Gemini (generator and judge). Free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Anthropic (Claude generator and judge). Either a direct API key...
ANTHROPIC_API_KEY=
# ...or LBL's CBORG gateway, which also serves Claude and free LBL-hosted models. LBL staff only.
CBORG_API_KEY=
CBORG_BASE_URL=https://api.cborg.lbl.gov/v1

# Local model servers. No keys; these are addresses. Leave one blank to skip that machine.
OLLAMA_M5_URL=http://localhost:11434
OLLAMA_YOGA_URL=

# Apple fm. Start the server first with `fm serve --port 1976`.
FM_SERVE_URL=http://localhost:1976
# A second Mac, reached through an SSH tunnel, e.g. `ssh -N -L 19762:localhost:1976 <host>`
# after running `fm serve --port 1976` there; then set this to http://localhost:19762
FM_SERVE_AIR_URL=
# Optional fallbacks, only used if a server stops reporting token usage: a command that reads
# text on stdin and prints its token count, e.g. fm count-tokens --quiet
FM_COUNT_TOKENS_CMD=
FM_COUNT_TOKENS_AIR_CMD=

# Local OpenViking instance, BERIL task only.
OPENVIKING_URL=http://127.0.0.1:1933
